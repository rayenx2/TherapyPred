# ClinicalOps-ML — Environment Variables
# Copy this file to .env and fill in values before running
# cp .env.example .env

# --- Inference API Settings ---
# Path to the trained Random Forest model artifact
MODEL_PATH=models/model.joblib

# Path to the Scikit-Learn preprocessor pipeline artifact
PREPROCESSOR_PATH=data/processed/preprocessor.joblib

# --- Security Settings ---
# Comma-separated list of allowed hosts for TrustedHostMiddleware
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Model Training ---
# Number of CPU cores for parallel Random Forest training (-1 = all cores)
N_JOBS=1

# --- Grafana ---
# Admin password for Grafana dashboard (change before production deploy)
GRAFANA_ADMIN_PASSWORD=changeme

# --- Monitoring ---
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# --- DVC ---
# Local remote path for DVC artifact storage
DVC_REMOTE_DIR=/tmp/dvc-remote
